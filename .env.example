# Supabase (Required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_PASSWORD=your-db-password
DATABASE_URL=postgresql://postgres:password@host:port/db

# Gmail SMTP (Required for emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=esutlibrary@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM="ESUT Library <esutlibrary@gmail.com>"

# Plausible Analytics (Optional)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=your-domain.com
NEXT_PUBLIC_PLAUSIBLE_SCRIPT_URL=https://plausible.io/js/script.js

# Sentry Error Monitoring (Optional)
NEXT_PUBLIC_SENTRY_DSN=https://key@o1.ingest.sentry.io/123
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# App Configuration
NEXT_PUBLIC_APP_URL=https://your-domain.com
NEXT_PUBLIC_APP_NAME="LIS 815"